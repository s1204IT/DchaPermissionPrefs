<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/common_bg_repeat"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/errorscreen_base"
        android:layout_width="666dp"
        android:layout_height="583dp"
        android:layout_marginLeft="307dp"
        android:layout_marginTop="98dp"
        android:src="@drawable/js002_05210_bg"
        android:contentDescription="@string/errorscreen_base"/>
    <ImageView
        android:id="@+id/errorscreen_title_error_occored"
        android:layout_width="308dp"
        android:layout_height="32dp"
        android:layout_marginLeft="491dp"
        android:layout_marginTop="147dp"
        android:src="@drawable/js002_05210_title"
        android:contentDescription="@string/errorscreen_title_error_occored"/>
    <ImageView
        android:id="@+id/errorscreen_text"
        android:layout_width="411dp"
        android:layout_height="18dp"
        android:layout_marginLeft="435dp"
        android:layout_marginTop="272dp"
        android:src="@drawable/js002_05210_text"
        android:contentDescription="@string/errorscreen_text"/>
    <ImageView
        android:id="@+id/errorscreen_qr_cd"
        android:layout_width="349dp"
        android:layout_height="198dp"
        android:layout_marginLeft="465dp"
        android:layout_marginTop="313dp"
        android:src="@drawable/js002_05210_qr"
        android:contentDescription="@string/errorscreen_qr_cd"/>
    <TextView
        android:textSize="@dimen/errorscreen_error_cd"
        android:textColor="#ff000000"
        android:id="@+id/errorscreen_error_cd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="519dp"
        android:layout_marginTop="545dp"
        android:contentDescription="@string/errorscreen_error_cd"/>
    <ImageView
        android:id="@+id/errorscreen_ok_btn"
        android:layout_width="201dp"
        android:layout_height="61dp"
        android:layout_marginLeft="540dp"
        android:layout_marginTop="581dp"
        android:src="@drawable/common_ok"
        android:contentDescription="@string/errorscreen_ok_btn"/>
</FrameLayout>
