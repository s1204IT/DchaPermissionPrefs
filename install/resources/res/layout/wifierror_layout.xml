<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/common_bg_repeat"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wifierror_main"
        android:layout_width="666dp"
        android:layout_height="691dp"
        android:layout_marginLeft="307dp"
        android:layout_marginTop="45dp"
        android:src="@drawable/js002_03010_bg"
        android:contentDescription="@string/wifierror_main"/>
    <ImageView
        android:id="@+id/wifierror_text"
        android:layout_width="355dp"
        android:layout_height="87dp"
        android:layout_marginLeft="462dp"
        android:layout_marginTop="254dp"
        android:src="@drawable/js002_03010_text"
        android:contentDescription="@string/wifierror_text"/>
    <ImageView
        android:id="@+id/wifierror_qr_cd"
        android:layout_width="363dp"
        android:layout_height="188dp"
        android:layout_marginLeft="458dp"
        android:layout_marginTop="448dp"
        android:src="@drawable/js002_03010_qr"
        android:contentDescription="@string/wifierror_qr_cd"/>
    <ImageView
        android:id="@+id/wifierror_ok_btn"
        android:layout_width="201dp"
        android:layout_height="61dp"
        android:layout_marginLeft="540dp"
        android:layout_marginTop="636dp"
        android:src="@drawable/common_ok"
        android:contentDescription="@string/wifierror_ok_btn"/>
    <ImageButton
        android:id="@+id/wifierror_hCheck"
        android:background="@drawable/common_internet"
        android:layout_width="239dp"
        android:layout_height="52dp"
        android:layout_marginLeft="520dp"
        android:layout_marginTop="371dp"/>
</FrameLayout>
