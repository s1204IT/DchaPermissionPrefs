    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/internetconnectionerror_bg_02"
        android:layout_width="666dp"
        android:layout_height="741dp"
        android:layout_marginLeft="307dp"
        android:layout_marginTop="19dp"
        android:src="@drawable/js002_03020_bg"
        android:contentDescription="@string/internetconnectionerror_bg_02"/>
    <ImageView
        android:id="@+id/internetconnectionerror_title"
        android:layout_width="447dp"
