<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/common_bg_repeat"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/errorscreen_base"
        android:layout_width="666dp"
        android:layout_height="673dp"
        android:layout_marginLeft="307dp"
        android:layout_marginTop="55dp"
        android:src="@drawable/js002_05110_bg"
        android:contentDescription="@string/errorscreen_base"/>
    <ImageView
        android:id="@+id/errorscreen_title_error_occored"
        android:layout_width="346dp"
        android:layout_height="44dp"
        android:layout_marginLeft="468dp"
        android:layout_marginTop="91dp"
        android:src="@drawable/js002_05110_title"
        android:contentDescription="@string/errorscreen_title_error_occored"/>
    <ImageView
        android:id="@+id/errorscreen_text"
        android:layout_width="395dp"
        android:layout_height="89dp"
        android:layout_marginLeft="439dp"
        android:layout_marginTop="263dp"
        android:src="@drawable/js002_05110_text"
        android:contentDescription="@string/errorscreen_text"/>
    <ImageView
        android:id="@+id/errorscreen_qr_cd"
        android:layout_width="371dp"
        android:layout_height="190dp"
        android:layout_marginLeft="454dp"
        android:layout_marginTop="438dp"
        android:src="@drawable/js002_05110_qr"
        android:contentDescription="@string/errorscreen_qr_cd"/>
    <TextView
        android:textSize="@dimen/errorscreen_error_cd"
        android:textColor="#ff000000"
        android:id="@+id/errorscreen_error_cd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="516dp"
        android:layout_marginTop="401dp"
        android:contentDescription="@string/errorscreen_error_cd"/>
    <ImageView
        android:id="@+id/errorscreen_ok_btn"
        android:layout_width="201dp"
        android:layout_height="61dp"
        android:layout_marginLeft="540dp"
        android:layout_marginTop="628dp"
        android:src="@drawable/common_ok"
        android:contentDescription="@string/errorscreen_ok_btn"/>
</FrameLayout>
