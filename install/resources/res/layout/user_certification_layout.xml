<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/common_bg_repeat"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/usercertification_title_login"
        android:layout_width="1280dp"
        android:layout_height="83dp"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="0dp"
        android:src="@drawable/common_title_login_ct2"
        android:contentDescription="@string/usercertification_title_login"/>
    <ImageView
        android:id="@+id/usercertification_text01"
        android:layout_width="657dp"
        android:layout_height="37dp"
        android:layout_marginLeft="312dp"
        android:layout_marginTop="101dp"
        android:src="@drawable/js002_04010_text01"
        android:contentDescription="@string/usercertification_text01"/>
    <ImageView
        android:id="@+id/usercertification_text02"
        android:layout_width="758dp"
        android:layout_height="43dp"
        android:layout_marginLeft="178dp"
        android:layout_marginTop="158dp"
        android:src="@drawable/js002_04010_text02"
        android:contentDescription="@string/usercertification_text02"/>
    <ImageView
        android:id="@+id/usercertification_bg02"
        android:layout_width="950dp"
        android:layout_height="372dp"
        android:layout_marginLeft="165dp"
        android:layout_marginTop="220dp"
        android:src="@drawable/js002_04010_bg02"
        android:contentDescription="@string/usercertification_bg02"/>
    <ImageView
        android:id="@+id/usercertification_text_ssl"
        android:layout_width="633dp"
        android:layout_height="14dp"
        android:layout_marginLeft="324dp"
        android:layout_marginTop="609dp"
        android:src="@drawable/common_text_ssl"
        android:contentDescription="@string/usercertification_text_ssl"/>
    <Button
        android:id="@+id/usercertification_quit_btn"
        android:background="@drawable/common_quit"
        android:layout_width="191dp"
        android:layout_height="61dp"
        android:layout_marginLeft="427dp"
        android:layout_marginTop="643dp"
        android:contentDescription="@string/usercertification_quit_btn_selector"/>
    <Button
        android:id="@+id/usercertification_login_btn"
        android:background="@drawable/common_login"
        android:layout_width="201dp"
        android:layout_height="61dp"
        android:layout_marginLeft="647dp"
        android:layout_marginTop="643dp"
        android:contentDescription="@string/usercertification_login_btn_selector"/>
    <Button
        android:id="@+id/usercertification_non_member_btn"
        android:background="@drawable/common_non_member"
        android:layout_width="163dp"
        android:layout_height="52dp"
        android:layout_marginLeft="951dp"
        android:layout_marginTop="676dp"
        android:contentDescription="@string/usercertification_non_member_btn_selector"/>
    <ImageView
        android:id="@+id/usercertification_alart"
        android:layout_width="657dp"
        android:layout_height="32dp"
        android:layout_marginLeft="359dp"
        android:layout_marginTop="229dp"
        android:src="@drawable/js002_04010_alart"
        android:contentDescription="@string/usercertification_alart"/>
    <ImageView
        android:id="@+id/usercertification_memberNo"
        android:layout_width="102dp"
        android:layout_height="39dp"
        android:layout_marginLeft="217dp"
        android:layout_marginTop="280dp"
        android:src="@drawable/js002_04010_member_num"
        android:contentDescription="@string/usercertification_member_num"/>
    <EditText
        android:textSize="@dimen/usercertification_edittext_id"
        android:textColor="#8c8c8c"
        android:id="@+id/usercertification_edittext_id"
        android:background="@drawable/js002_04010_flame_disable"
        android:paddingLeft="22dp"
        android:focusable="false"
        android:layout_width="664dp"
        android:layout_height="70dp"
        android:layout_marginLeft="359dp"
        android:layout_marginTop="270dp"
        android:maxLength="10"
        android:inputType="number"
        android:imeOptions="actionNext"
        android:fontFamily="gjsgm"/>
    <ImageView
        android:id="@+id/usercertification_pass"
        android:background="@drawable/js002_04010_pass"
        android:layout_width="114dp"
        android:layout_height="23dp"
        android:layout_marginLeft="218dp"
        android:layout_marginTop="375dp"
        android:contentDescription="@string/usercertification_pass"/>
    <EditText
        android:textSize="@dimen/usercertification_edittext_password"
        android:textColor="#000000"
        android:id="@+id/usercertification_edittext_password"
        android:background="@drawable/js002_04010_flame_current"
        android:paddingLeft="22dp"
        android:layout_width="664dp"
        android:layout_height="70dp"
        android:layout_marginLeft="359dp"
        android:layout_marginTop="350dp"
        android:maxLength="32"
        android:inputType="textPassword"
        android:fontFamily="gjsgm"/>
    <ImageView
        android:id="@+id/usercertification_checkbox"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="359dp"
        android:layout_marginTop="435dp"
        android:src="@drawable/js002_04010_checkbox"
        android:contentDescription="@string/usercertification_checkbox"/>
    <ImageView
        android:id="@+id/usercertification_hecktext"
        android:layout_width="150dp"
        android:layout_height="31dp"
        android:layout_marginLeft="399dp"
        android:layout_marginTop="428dp"
        android:src="@drawable/js002_04010_checktext"
        android:contentDescription="@string/usercertification_checktext"/>
    <ImageView
        android:id="@+id/usercertification_text03"
        android:layout_width="678dp"
        android:layout_height="57dp"
        android:layout_marginLeft="359dp"
        android:layout_marginTop="493dp"
        android:src="@drawable/js002_04010_text03"
        android:contentDescription="@string/usercertification_text03"/>
    <ImageView
        android:id="@+id/usercertification_check"
        android:layout_width="30dp"
        android:layout_height="24dp"
        android:layout_marginLeft="364dp"
        android:layout_marginTop="437dp"
        android:src="@drawable/js002_04010_check"
        android:contentDescription="@string/usercertification_check"/>
    <ImageView
        android:id="@+id/lock_alert"
        android:visibility="invisible"
        android:layout_width="720dp"
        android:layout_height="350dp"
        android:layout_marginLeft="353dp"
        android:layout_marginTop="225dp"
        android:src="@drawable/js002_04010_lock_alert"
        android:contentDescription="@string/lock_alert"/>
</FrameLayout>
